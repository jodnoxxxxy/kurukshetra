# AI/ML Environment Variables
# Copy this file to .env and update with your values

# Python Environment
PYTHONPATH=.
PYTHONDONTWRITEBYTECODE=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=5001
FLASK_DEBUG=False
FLASK_ENV=development

# Database - MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=kurukshetra_ml
MYSQL_CONNECTION_POOL=5

# Database - Firebase
FIREBASE_PROJECT_ID=kurukshetra-dev
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_STORAGE_BUCKET=kurukshetra-dev.appspot.com
FIREBASE_CREDENTIALS_PATH=./firebase-key.json

# Model Configuration
MODEL_PATH=./models/
DATA_PATH=./data/
LOG_PATH=./logs/
CHECKPOINT_PATH=./models/checkpoints/

# Training Configuration
TRAINING_EPOCHS=100
BATCH_SIZE=32
LEARNING_RATE=0.001
VALIDATION_SPLIT=0.2
TEST_SPLIT=0.2
RANDOM_STATE=42

# GPU/CUDA Configuration
USE_GPU=True
CUDA_VISIBLE_DEVICES=0
TF_CPP_MIN_LOG_LEVEL=2

# Performance Configuration
NUM_WORKERS=4
CACHE_MODELS=True
OPTIMIZE_MODEL=True

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_METRICS=True
METRICS_PORT=8000

# External Services
WEATHER_API_KEY=your_weather_api_key
WEATHER_SERVICE=openweathermap

# Security
DATA_VALIDATION=True
INPUT_SANITIZATION=True
ENCRYPTION_ENABLED=False

# Development
DEBUG_MODE=False
VERBOSE_OUTPUT=False
SAVE_INTERMEDIATE_RESULTS=False
