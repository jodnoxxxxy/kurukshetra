// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Farmer {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  phone             String?
  passwordHash      String   @map("password_hash")
  location          String?
  state             String?
  district          String?
  village           String?
  verified          Boolean  @default(false)
  languagePreference String @default("en") @map("language_preference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  farms             Farm[]
  chatMessages      ChatMessage[]
  soilAnalyses      SoilAnalysis[]
  pestDetections    PestDetection[]

  @@map("farmers")
}

model Farm {
  id              String    @id @default(uuid())
  farmerId        String    @map("farmer_id")
  farmName        String?   @map("farm_name")
  locationName    String?   @map("location_name")
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  areaAcres       Decimal?  @db.Decimal(10, 2) @map("area_acres")
  soilType        String?   @map("soil_type")
  irrigationSource String?  @map("irrigation_source")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  farmer          Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crops           Crop[]
  soilAnalyses    SoilAnalysis[]

  @@map("farms")
}

model Crop {
  id                String    @id @default(uuid())
  farmId            String    @map("farm_id")
  cropName          String    @map("crop_name")
  variety           String?
  plantingDate      DateTime? @map("planting_date") @db.Date
  expectedHarvest   DateTime? @map("expected_harvest") @db.Date
  actualHarvest     DateTime? @map("actual_harvest") @db.Date
  status            String    @default("planted") // planted, growing, ready, harvested
  areaPlanted       Decimal?  @db.Decimal(10, 2) @map("area_planted")
  yieldEstimated    Decimal?  @db.Decimal(10, 2) @map("yield_estimated")
  yieldActual       Decimal?  @db.Decimal(10, 2) @map("yield_actual")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pestDetections    PestDetection[]

  @@map("crops")
}

model MarketPrice {
  id            String   @id @default(uuid())
  cropName      String   @map("crop_name")
  variety       String?
  pricePerQuintal Decimal @db.Decimal(10, 2) @map("price_per_quintal")
  mandiName     String   @map("mandi_name")
  district      String?
  state         String?
  priceDate     DateTime @map("price_date") @db.Date
  changePercent Decimal? @db.Decimal(5, 2) @map("change_percent")
  trend         String?  // up, down, stable
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([cropName, priceDate], map: "idx_market_prices_crop_date")
  @@map("market_prices")
}

model ChatMessage {
  id            String   @id @default(uuid())
  farmerId      String   @map("farmer_id")
  sessionId     String?  @map("session_id")
  messageText   String   @map("message_text")
  isFromUser    Boolean  @map("is_from_user")
  messageType   String   @default("text") @map("message_type") // text, image, audio
  aiConfidence  Decimal? @db.Decimal(3, 2) @map("ai_confidence")
  responseTimeMs Int?    @map("response_time_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId], map: "idx_chat_messages_farmer_id")
  @@index([sessionId], map: "idx_chat_messages_session")
  @@map("chat_messages")
}

model SoilAnalysis {
  id            String   @id @default(uuid())
  farmId        String   @map("farm_id")
  nitrogenPpm   Decimal?  @db.Decimal(8, 2) @map("nitrogen_ppm")
  phosphorusPpm Decimal?  @db.Decimal(8, 2) @map("phosphorus_ppm")
  potassiumPpm  Decimal?  @db.Decimal(8, 2) @map("potassium_ppm")
  phLevel       Decimal?  @db.Decimal(4, 2) @map("ph_level")
  organicMatter Decimal?  @db.Decimal(5, 2) @map("organic_matter")
  healthScore   Decimal?  @db.Decimal(3, 2) @map("health_score") // 0-100
  recommendations Json?  // Store AI recommendations as JSON
  analyzedAt    DateTime @default(now()) @map("analyzed_at")

  // Relations
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade, map: "soil_analyses_farm_fkey")
  farmer        Farmer   @relation(fields: [farmId], references: [id], onDelete: Cascade, map: "soil_analyses_farmer_fkey")

  @@map("soil_analyses")
}

model PestDetection {
  id                      String   @id @default(uuid())
  farmerId                String   @map("farmer_id")
  cropId                  String?  @map("crop_id")
  imageUrl                String?  @map("image_url")
  pestName                String?  @map("pest_name")
  confidenceScore         Decimal? @db.Decimal(3, 2) @map("confidence_score")
  severity                String?  // low, medium, high
  treatmentRecommendations Json?   @map("treatment_recommendations") // Store as JSON
  detectedAt              DateTime @default(now()) @map("detected_at")

  // Relations
  farmer                  Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop                    Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@map("pest_detections")
}
