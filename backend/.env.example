# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/kurukshetra?schema=public"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_characters
JWT_EXPIRE_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_too
JWT_REFRESH_EXPIRE_IN=30d

# Redis Configuration (optional for caching)
REDIS_URL=redis://localhost:6379

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Configuration
FRONTEND_URL=http://localhost:63783

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# AI Services (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Python AI Services URLs
SOIL_ANALYSIS_URL=http://localhost:8001/soil/analyze
PEST_DETECTION_URL=http://localhost:8002/pest/detect
CROP_RECOMMENDATION_URL=http://localhost:8003/crop/recommend

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
