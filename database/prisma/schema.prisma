// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Farmer {
  id                String   @id @default(uuid())
  name              String
  email             String   @unique
  phone             String?
  passwordHash      String   @map("password_hash")
  location          String?
  state             String?
  district          String?
  village           String?
  verified          Boolean  @default(false)
  languagePreference String @default("en") @map("language_preference")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  farms             Farm[]
  chatMessages      ChatMessage[]
  soilAnalyses      SoilAnalysis[]
  pestDetections    PestDetection[]

  @@map("farmers")
}

model Farm {
  id              String    @id @default(uuid())
  farmerId        String    @map("farmer_id")
  farmName        String?   @map("farm_name")
  locationName    String?   @map("location_name")
  latitude        Float?
  longitude       Float?
  areaAcres       Float?    @map("area_acres")
  soilType        String?   @map("soil_type")
  irrigationSource String?  @map("irrigation_source")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  farmer          Farmer    @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crops           Crop[]
  soilAnalyses    SoilAnalysis[]

  @@map("farms")
}

model Crop {
  id                String    @id @default(uuid())
  farmId            String    @map("farm_id")
  cropName          String    @map("crop_name")
  variety           String?
  plantingDate      DateTime? @map("planting_date")
  expectedHarvest   DateTime? @map("expected_harvest")
  actualHarvest     DateTime? @map("actual_harvest")
  status            String    @default("planted") // planted, growing, ready, harvested
  areaPlanted       Float?    @map("area_planted")
  yieldEstimated    Float?    @map("yield_estimated")
  yieldActual       Float?    @map("yield_actual")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  farm              Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pestDetections    PestDetection[]

  @@map("crops")
}

model MarketPrice {
  id            String   @id @default(uuid())
  cropName      String   @map("crop_name")
  variety       String?
  pricePerQuintal Float @map("price_per_quintal")
  mandiName     String   @map("mandi_name")
  district      String?
  state         String?
  priceDate     DateTime @map("price_date")
  changePercent Float? @map("change_percent")
  trend         String?  // up, down, stable
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([cropName, priceDate], map: "idx_market_prices_crop_date")
  @@map("market_prices")
}

model ChatMessage {
  id            String   @id @default(uuid())
  farmerId      String   @map("farmer_id")
  sessionId     String?  @map("session_id")
  messageText   String   @map("message_text")
  isFromUser    Boolean  @map("is_from_user")
  messageType   String   @default("text") @map("message_type") // text, image, audio
  aiConfidence  Float? @map("ai_confidence")
  responseTimeMs Int?    @map("response_time_ms")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([farmerId], map: "idx_chat_messages_farmer_id")
  @@index([sessionId], map: "idx_chat_messages_session")
  @@map("chat_messages")
}

model SoilAnalysis {
  id            String   @id @default(uuid())
  farmId        String   @map("farm_id")
  farmerId      String   @map("farmer_id")
  nitrogenPpm   Float?  @map("nitrogen_ppm")
  phosphorusPpm Float?  @map("phosphorus_ppm")
  potassiumPpm  Float?  @map("potassium_ppm")
  phLevel       Float?  @map("ph_level")
  organicMatter Float?  @map("organic_matter")
  healthScore   Float?  @map("health_score") // 0-100
  recommendations String?
  analyzedAt    DateTime @default(now()) @map("analyzed_at")

  // Relations
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("soil_analyses")
}

model PestDetection {
  id                      String   @id @default(uuid())
  farmerId                String   @map("farmer_id")
  cropId                  String?  @map("crop_id")
  imageUrl                String?  @map("image_url")
  pestName                String?  @map("pest_name")
  confidenceScore         Float? @map("confidence_score")
  severity                String?  // low, medium, high
  treatmentRecommendations String?   @map("treatment_recommendations")
  detectedAt              DateTime @default(now()) @map("detected_at")

  // Relations
  farmer                  Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crop                    Crop?    @relation(fields: [cropId], references: [id], onDelete: SetNull)

  @@map("pest_detections")
}
